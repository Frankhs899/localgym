# LocalGym — variables de entorno del backend.
# Copiar este archivo a backend/.env (fuera de git) y completar los valores.

# Obligatoria: sin ella el backend no arranca (no hay clave por defecto, a
# propósito: una clave conocida públicamente permitiría falsificar sesiones y
# firmas). Generar una por instalación:
#   backend/.venv/Scripts/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
LOCALGYM_SECRET_KEY=

# Solo en desarrollo: con True Django muestra páginas de error detalladas.
# Por defecto False.
LOCALGYM_DEBUG=False

# Carpeta de datos persistente (base de datos y respaldos).
# Por defecto: <raíz del repo>/data
# LOCALGYM_DATA_DIR=
